; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Rejeweled"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(1, 0.823529, 0.909804, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://images/icon.png"

[autoload]

Globals="*res://scripts/globals.gd"
LevelList="*res://scripts/level_list.gd"
Board="*res://scripts/board.gd"
BoardLogic="*res://scripts/board_logic.gd"
Grid="*res://scripts/grid.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=2800
window/size/window_width_override=400
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom_font="res://fonts/Wash Your Hand.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
